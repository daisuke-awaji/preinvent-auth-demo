{
  "name": "preinvent-auth-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pre:Invent 2026 AI agent auth updates demo (Cognito CIMD/DCR, AgentCore Gateway JWT condition keys, Cognito token exchange)",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "setup:aws": "node scripts/setup-aws.js",
    "teardown:aws": "node scripts/teardown-aws.js",
    "build:pages": "node scripts/build-pages.js",
    "preview:pages": "node scripts/preview-pages.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1175.0",
    "@aws-sdk/client-cloudfront": "^3.1175.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1175.0",
    "@aws-sdk/client-iam": "^3.1175.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-sts": "^3.1175.0",
    "express": "^5.3.0",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
